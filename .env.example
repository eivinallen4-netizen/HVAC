# ─── Housecall Pro (required for leads to reach your CRM) ───
# HCP → App Store → API → "Generate API key". Requires the Housecall Pro MAX plan.
# Website leads show up in Job Inbox → "API Leads".
HOUSECALL_API_KEY=

# ─── Backup lead copy (optional but recommended) ───
# Every lead is also POSTed here as JSON — e.g. a Zapier/Make webhook that emails
# or texts the office, or a Slack webhook. Nothing is lost if HCP is ever down.
LEAD_WEBHOOK_URL=

# ─── Tracking (optional) ───
# Google Tag Manager container. The old WordPress site used GTM-PG4H6BFL.
NEXT_PUBLIC_GTM_ID=
# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=
